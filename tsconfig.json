{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "inlineSources": true,
    // Ensure original TS content is mapped
    "sourceRoot": "./src"
    // Tells the debugger exactly where files live
  },
  "include": [
    "src"
  ]
}
